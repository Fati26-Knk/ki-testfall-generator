# Project environment template
# Copy the backend values to `backend/.env` and the frontend value to `frontend/.env`.

# Backend
LLM_PROVIDER=openai
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.1-chat-latest
OPENAI_TEMPERATURE=0.2
OPENAI_TOP_P=1.0
OPENAI_MAX_TOKENS=16384
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80
DATABASE_URL=postgresql://testgen:testgen_secret@localhost:5432/testgen_db

# Frontend
# The backend serves its API routes from the root path, so no `/api/v1` suffix here.
VITE_API_URL=http://localhost:8000
